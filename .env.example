# ============================================================
# Enter.pro – Environment Variables
# ============================================================
# Copy this file to .env and fill in the values below.
# Get your Project ID and Token from: https://enter.pro
# ============================================================

# Enable or disable Enter analytics (true | false)
VITE_ENTER_ANALYTICS_ENABLED=true

# Your Enter.pro analytics token (found in project settings)
VITE_ENTER_ANALYTICS_TOKEN=

# Your Enter.pro project ID (found in project settings)
VITE_ENTER_PROJECT_ID=

# Base API endpoint for Enter analytics (do not change unless self-hosting)
VITE_ENTER_ANALYTICS_ENDPOINT=https://api.enter.pro

# Endpoint for analytics definitions (leave empty to use default)
VITE_ENTER_ANALYTICS_DEFINITIONS_ENDPOINT=

# Enable verbose debug logging for analytics (true | false)
VITE_ENTER_ANALYTICS_DEBUG=false
